<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========== Invoice Sequence ========== -->
    <record id="seq_sunnypay_invoice" model="ir.sequence">
        <field name="name">SunnyPay Invoice</field>
        <field name="code">sunnypay.invoice</field>
        <field name="prefix">SINV/%(year)s/</field>
        <field name="padding">5</field>
    </record>

    <!-- ========== Invoice Tree View ========== -->
    <record id="view_sunnypay_invoice_tree" model="ir.ui.view">
        <field name="name">sunnypay.invoice.tree</field>
        <field name="model">sunnypay.invoice</field>
        <field name="arch" type="xml">
            <tree string="Invoices"
                  decoration-success="status == 'paid'"
                  decoration-danger="status == 'overdue'"
                  decoration-warning="status in ('sent', 'viewed')"
                  decoration-info="status == 'partially_paid'">
                <field name="name"/>
                <field name="customer_name"/>
                <field name="customer_email"/>
                <field name="amount" sum="Total"/>
                <field name="amount_paid" sum="Total Paid"/>
                <field name="amount_due" sum="Total Due"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="due_date"/>
                <field name="status"
                       widget="badge"
                       decoration-success="status == 'paid'"
                       decoration-danger="status == 'overdue'"
                       decoration-warning="status in ('sent', 'viewed')"
                       decoration-info="status == 'partially_paid'"/>
                <field name="merchant_id" optional="show"/>
            </tree>
        </field>
    </record>

    <!-- ========== Invoice Form View ========== -->
    <record id="view_sunnypay_invoice_form" model="ir.ui.view">
        <field name="name">sunnypay.invoice.form</field>
        <field name="model">sunnypay.invoice</field>
        <field name="arch" type="xml">
            <form string="Invoice">
                <header>
                    <button name="action_create_odoo_invoice"
                            type="object"
                            string="Create Odoo Invoice"
                            class="btn-primary"
                            icon="fa-file-text-o"
                            invisible="odoo_invoice_id"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,sent,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Invoice Details">
                            <field name="amount"/>
                            <field name="amount_paid"/>
                            <field name="amount_due"/>
                            <field name="currency_id"/>
                            <field name="issue_date"/>
                            <field name="due_date"/>
                        </group>
                        <group string="Customer">
                            <field name="customer_name"/>
                            <field name="customer_email"/>
                            <field name="customer_phone"/>
                            <field name="customer_address"/>
                        </group>
                    </group>
                    <group>
                        <group string="References">
                            <field name="sunnypay_id"/>
                            <field name="merchant_id"/>
                            <field name="odoo_invoice_id"/>
                            <field name="payment_link" widget="url"/>
                        </group>
                        <group string="Notes">
                            <field name="description"/>
                            <field name="notes"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payments">
                            <field name="transaction_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="amount"/>
                                    <field name="payment_method"/>
                                    <field name="status" widget="badge"/>
                                    <field name="transaction_date"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Line Items (Raw)" invisible="not item_lines">
                            <field name="item_lines"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ========== Invoice Search View ========== -->
    <record id="view_sunnypay_invoice_search" model="ir.ui.view">
        <field name="name">sunnypay.invoice.search</field>
        <field name="model">sunnypay.invoice</field>
        <field name="arch" type="xml">
            <search string="Search Invoices">
                <field name="name"/>
                <field name="customer_name"/>
                <field name="customer_email"/>
                <field name="merchant_id"/>
                <separator/>
                <filter string="Paid" name="paid"
                        domain="[('status', '=', 'paid')]"/>
                <filter string="Overdue" name="overdue"
                        domain="[('status', '=', 'overdue')]"/>
                <filter string="Pending" name="pending"
                        domain="[('status', 'in', ('draft', 'sent', 'viewed'))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status"
                            context="{'group_by': 'status'}"/>
                    <filter string="Merchant" name="group_merchant"
                            context="{'group_by': 'merchant_id'}"/>
                    <filter string="Due Date" name="group_due"
                            context="{'group_by': 'due_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ========== Invoice Action ========== -->
    <record id="action_sunnypay_invoice_list" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">sunnypay.invoice</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sunnypay_invoice_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No invoices yet
            </p>
            <p>
                Sync invoices from SunnyPay via Settings → SunnyPay → Sync All Data.
            </p>
        </field>
    </record>
</odoo>
