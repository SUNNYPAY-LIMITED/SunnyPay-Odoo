<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sync Transactions Cron -->
    <record id="cron_sunnypay_sync_transactions" model="ir.cron">
        <field name="name">SunnyPay: Sync Transactions</field>
        <field name="model_id" ref="model_sunnypay_transaction"/>
        <field name="state">code</field>
        <field name="code">model.action_sync_from_sunnypay()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
        <field name="priority">10</field>
    </record>

    <!-- Sync Merchants Cron -->
    <record id="cron_sunnypay_sync_merchants" model="ir.cron">
        <field name="name">SunnyPay: Sync Merchants</field>
        <field name="model_id" ref="model_sunnypay_merchant"/>
        <field name="state">code</field>
        <field name="code">model.action_sync_from_sunnypay()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
        <field name="priority">20</field>
    </record>

    <!-- Sync Invoices Cron -->
    <record id="cron_sunnypay_sync_invoices" model="ir.cron">
        <field name="name">SunnyPay: Sync Invoices</field>
        <field name="model_id" ref="model_sunnypay_invoice"/>
        <field name="state">code</field>
        <field name="code">model.action_sync_from_sunnypay()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
        <field name="priority">15</field>
    </record>

    <!-- Sync Customers Cron -->
    <record id="cron_sunnypay_sync_customers" model="ir.cron">
        <field name="name">SunnyPay: Sync Customers</field>
        <field name="model_id" ref="model_sunnypay_customer"/>
        <field name="state">code</field>
        <field name="code">model.action_sync_from_sunnypay()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
        <field name="priority">25</field>
    </record>
</odoo>
